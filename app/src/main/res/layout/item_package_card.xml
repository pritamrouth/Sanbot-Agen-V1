<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/packageCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_medium"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <View
            android:id="@+id/packageImage"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@drawable/bg_package_placeholder" />

        <TextView
            android:id="@+id/packageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Package Title"
            android:textSize="@dimen/text_h3"
            android:textColor="@color/dark_gray"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/spacing_small" />

        <TextView
            android:id="@+id/packagePriceAndDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AED 299 • 6 hours"
            android:textSize="@dimen/text_body"
            android:textColor="@color/brand_orange"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/packageRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⭐ 4.8 (234 reviews)"
            android:textSize="@dimen/text_caption"
            android:textColor="#666666"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_view_details"
            android:textSize="@dimen/text_body"
            android:textColor="@color/brand_blue"
            android:textStyle="bold"
            android:gravity="end"
            android:layout_marginTop="@dimen/spacing_small"
            android:drawableEnd="@drawable/ic_chevron_right"
            android:drawableTint="@color/brand_blue" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
