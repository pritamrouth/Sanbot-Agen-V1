<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:background="@color/brand_blue"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:contentDescription="Back"
                android:tint="@color/white" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/homeButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_home"
                android:contentDescription="Home"
                android:tint="@color/white" />

        </LinearLayout>

        <View
            android:id="@+id/heroImage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@drawable/bg_package_placeholder"
            app:layout_constraintTop_toBottomOf="@id/toolbar" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/heroImage"
            app:layout_constraintBottom_toTopOf="@id/actionButtons">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large">

                <TextView
                    android:id="@+id/packageTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Package Title"
                    android:textSize="@dimen/text_h2"
                    android:textColor="@color/dark_gray"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/packagePrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AED 299 per person"
                    android:textSize="@dimen/text_h3"
                    android:textColor="@color/brand_orange"
                    android:layout_marginTop="@dimen/spacing_small" />

                <TextView
                    android:id="@+id/packageRating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⭐ 4.8 (234 reviews)"
                    android:textSize="@dimen/text_body"
                    android:textColor="#666666"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/packageDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Description"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/dark_gray"
                    android:layout_marginTop="@dimen/spacing_medium" />

                <LinearLayout
                    android:id="@+id/highlightsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/section_highlights"
                        android:textSize="@dimen/text_h3"
                        android:textColor="@color/dark_gray"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/highlightsArrow"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_expand"
                        android:rotation="180"
                        android:tint="@color/dark_gray" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/highlightsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_medium" />

                <LinearLayout
                    android:id="@+id/itineraryHeader"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/section_itinerary"
                        android:textSize="@dimen/text_h3"
                        android:textColor="@color/dark_gray"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/itineraryArrow"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_expand"
                        android:rotation="180"
                        android:tint="@color/dark_gray" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/itineraryContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_medium" />

                <LinearLayout
                    android:id="@+id/inclusionsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/section_inclusions"
                        android:textSize="@dimen/text_h3"
                        android:textColor="@color/dark_gray"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/inclusionsArrow"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_expand"
                        android:rotation="180"
                        android:tint="@color/dark_gray" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/inclusionsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_medium" />

                <LinearLayout
                    android:id="@+id/exclusionsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/section_exclusions"
                        android:textSize="@dimen/text_h3"
                        android:textColor="@color/dark_gray"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/exclusionsArrow"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_expand"
                        android:rotation="180"
                        android:tint="@color/dark_gray" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/exclusionsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_medium"
                    android:paddingBottom="@dimen/spacing_xlarge" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/actionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_medium"
            android:background="@color/white"
            android:elevation="8dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bookNowButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/spacing_small"
                android:text="@string/btn_book_now"
                android:textColor="@color/white"
                app:backgroundTint="@color/brand_blue"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/getQuoteButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/btn_get_quote"
                android:textColor="@color/brand_blue"
                app:strokeColor="@color/brand_blue"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
