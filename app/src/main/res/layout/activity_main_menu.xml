<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_gray"
    tools:context=".ui.menu.MainMenuActivity">

    <!-- Background Gradient -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_video_placeholder" />

    <!-- Gradient Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient_overlay" />

    <!-- Content -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/grid_margin">

        <!-- Header Logo -->
        <ImageView
            android:id="@+id/headerLogo"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:src="@drawable/logo_tripandevent"
            android:contentDescription="TripAndEvent Logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="@dimen/spacing_medium" />

        <!-- Main Title -->
        <TextView
            android:id="@+id/menuTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_menu_title"
            android:textSize="@dimen/text_h2"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/headerLogo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/spacing_xlarge" />

        <!-- Menu Grid -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/menuGrid"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/menuTitle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/spacing_xlarge"
            android:layout_marginBottom="@dimen/spacing_xlarge">

            <!-- Tours Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTours"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:cardBackgroundColor="@color/brand_blue"
                app:cardCornerRadius="@dimen/button_corner_radius"
                app:cardElevation="8dp"
                android:layout_margin="@dimen/spacing_small"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/cardInfo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/cardEvents"
                app:layout_constraintHeight_percent="0.45"
                app:layout_constraintWidth_percent="0.45">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/menu_tours"
                    android:textSize="@dimen/text_h2"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:gravity="center" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Events Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEvents"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:cardBackgroundColor="@color/brand_orange"
                app:cardCornerRadius="@dimen/button_corner_radius"
                app:cardElevation="8dp"
                android:layout_margin="@dimen/spacing_small"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/cardHelp"
                app:layout_constraintStart_toEndOf="@id/cardTours"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.45"
                app:layout_constraintWidth_percent="0.45">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/menu_events"
                    android:textSize="@dimen/text_h2"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:gravity="center" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Information Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardInfo"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:cardBackgroundColor="@color/success_green"
                app:cardCornerRadius="@dimen/button_corner_radius"
                app:cardElevation="8dp"
                android:layout_margin="@dimen/spacing_small"
                app:layout_constraintTop_toBottomOf="@id/cardTours"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/cardHelp"
                app:layout_constraintHeight_percent="0.45"
                app:layout_constraintWidth_percent="0.45">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/menu_info"
                    android:textSize="@dimen/text_h2"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:gravity="center" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Help Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHelp"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:cardBackgroundColor="@color/warning_yellow"
                app:cardCornerRadius="@dimen/button_corner_radius"
                app:cardElevation="8dp"
                android:layout_margin="@dimen/spacing_small"
                app:layout_constraintTop_toBottomOf="@id/cardEvents"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/cardInfo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.45"
                app:layout_constraintWidth_percent="0.45">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/menu_help"
                    android:textSize="@dimen/text_h2"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:gravity="center" />

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
